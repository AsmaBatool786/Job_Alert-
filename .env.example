# Copy this file's contents into GitHub repo secrets (Settings → Secrets and
# variables → Actions), or export these as environment variables for local
# testing. Never commit a real .env file.

# Comma-separated search terms. Mixing languages helps on non-English job boards.
SEARCH_KEYWORDS=data scientist,machine learning,dataanalytiker

# Optional: comma-separated location/municipality codes to restrict the search.
# Leave blank to search nationwide.
MUNICIPALITIES=

# How many hours back to look for "new" postings. Should be a bit more than
# your schedule's run interval so nothing slips through the gap.
LOOKBACK_HOURS=36

# API key from https://resend.com (free tier: 3,000 emails/month)
RESEND_API_KEY=

# Where to send the alert email
TO_EMAIL=

# --- Optional: AI relevance scoring ---
# Leave these three blank to use plain keyword matching only.

# From https://aistudio.google.com (free tier, no card required)
GEMINI_API_KEY=

# A few sentences describing your background/skills/interests
CV_SUMMARY=

# Minimum score 0-10 to include a job (default: 6)
RELEVANCE_THRESHOLD=6
